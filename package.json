{
  "name": "vendorpay-app",
  "version": "1.5.0",
  "private": true,
  "description": "VendorPay: supplier onboarding, masked bank details, scheduled supplier payments and audit trail. Reference application for QIVVRA change assurance.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui"
  },
  "dependencies": {
    "express": "4.21.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
